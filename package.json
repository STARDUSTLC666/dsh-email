{
  "name": "dsh-email",
  "version": "0.16.1",
  "description": "在 DSH 中收发、搜索和整理邮件，支持多个邮箱账号。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/whale-fallback.png",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run build && node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "email",
    "imap",
    "smtp"
  ],
  "author": "stardustlc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-email.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-email/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-email#readme",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3",
    "imapflow": "^2.2.1",
    "mailparser": "^3.9.33",
    "nodemailer": "^10.0.13",
    "proper-lockfile": "4.1.2",
    "schemastery": "^3.18.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.7.3"
  }
}
