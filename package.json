{
  "name": "dsh-email",
  "version": "0.20.4",
  "description": "DSH 邮件工作台：IMAP / SMTP 与 AgentMail 多账号、收件与已发送、搜索附件、草稿预览和确认发送。欢迎提交 issues 和 PR。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/whale-fallback.png",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-client.mjs && node scripts/build-updates.mjs",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run build && node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "email",
    "imap",
    "smtp",
    "agentmail"
  ],
  "author": "stardustlc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-email.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-email/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-email#readme",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3",
    "imapflow": "^2.2.1",
    "mailparser": "^3.9.33",
    "nodemailer": "^10.0.13",
    "proper-lockfile": "4.1.2",
    "schemastery": "^3.18.0",
    "yaml": "^2.9.0",
    "@stardustlc/dsh-updates": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.7.3"
  }
}
